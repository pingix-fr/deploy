APP_NAME="{{ app }}"
APP_ENV=production
APP_KEY={{ app_key }}
APP_DEBUG=false
APP_URL={{ app_url }}

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE={{ db }}
DB_USERNAME={{ db }}
DB_PASSWORD={{ db_password }}

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379