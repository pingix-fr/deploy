{
    "name": "pingix/deploy",
    "description": "Déploiement zero-downtime d'applications Laravel sur n'importe quel VPS, en une commande.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "deploy", "deployment", "zero-downtime", "vps", "provisioning"],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "symfony/process": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Pingix\\Deploy\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pingix\\Deploy\\DeployServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
